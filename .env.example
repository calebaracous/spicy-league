# Copy to .env.local. Every var is optional at the schema level (src/lib/env.ts),
# but features that need one will fail or no-op without it. See docs/ENV.md.

# Node environment — set automatically by Next.js, leave blank for dev
NODE_ENV=

# Public URL of the app. Used as the Better Auth client baseURL and as a
# trusted origin. Dev: http://localhost:3000  Prod: https://www.spicyleague.dev
NEXT_PUBLIC_APP_URL=

# Postgres connection string (Neon). Required for any DB-backed page.
# Example: postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Better Auth signing secret, 32+ chars — generate with `openssl rand -base64 32`
# (AUTH_SECRET is still read as a fallback.)
BETTER_AUTH_SECRET=

# Fixed Better Auth base URL. Leave blank to auto-detect from the request host.
# Prod must use the www form: https://www.spicyleague.dev
BETTER_AUTH_URL=

# Resend API key for verification + password-reset emails
AUTH_RESEND_KEY=

# Address auth emails send from. Must be on a domain verified in Resend.
# Defaults to no-reply@spicyleague.dev
AUTH_EMAIL_FROM=

# Riot Games API keys — personal key is preferred when both are set.
# Personal API Key (stable, non-expiring) — apply at https://developer.riotgames.com
RIOT_PERSONAL_API_KEY=
# Developer Key (expires every 24h) — fine for local dev
RIOT_DEVELOPER_API_KEY=

# Bearer token Vercel Cron sends to /api/cron/refresh-stats
CRON_SECRET=

# Vercel Blob (planned avatar uploads — not wired yet)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (for rate limiting) — unset is fine; rate limiting no-ops without these
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to 1 to skip env validation (use only in CI for non-runtime builds)
SKIP_ENV_VALIDATION=
